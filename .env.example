BOOTSTRAP_DATABASE_URL=postgresql://owner:replace-password@your-neon-host/postgres?sslmode=require&channel_binding=require
AUTH_DATABASE_NAME=auth-service
USER_DATABASE_NAME=user-service
CAPSTONE_DATABASE_NAME=capstone-service
# Optional owner URL when capstone uses a different Neon endpoint/project.
# CAPSTONE_BOOTSTRAP_DATABASE_URL=postgresql://owner:password@direct-neon-host/capstone-service?sslmode=require
# Optional pooler hostname for runtime; migrations keep using the owner URL above.
# CAPSTONE_RUNTIME_DATABASE_HOST=your-neon-pooler-host
# Leave these entries absent or empty to generate random credentials during bootstrap.
# AUTH_DB_PASSWORD=
# USER_DB_PASSWORD=
# CAPSTONE_DB_PASSWORD=
# AUTH_INTERNAL_TOKEN=
# USER_INTERNAL_TOKEN=
ADMIN_EMAIL=admin@capstone.local
# ADMIN_PASSWORD=replace-with-12-to-72-byte-password
